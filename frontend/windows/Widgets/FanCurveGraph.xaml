<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="XmaX.Widgets.FanCurveGraph"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <Grid x:Name="RootGrid" Background="Transparent">
        <!-- Static layer: grid and axes (redrawn only on load/resize) -->
        <Canvas x:Name="GridCanvas" />
        <!-- Dynamic layer: points and lines (redrawn on drag) -->
        <Canvas x:Name="PointsCanvas" />
        <!-- Tooltip layer: shows point values on hover/drag -->
        <Canvas x:Name="TooltipCanvas" IsHitTestVisible="False">
            <Border x:Name="TooltipBorder" Background="{ThemeResource SystemControlBackgroundChromeMediumBrush}" CornerRadius="4" Padding="6,4" Visibility="Collapsed">
                <TextBlock x:Name="TooltipText" Style="{StaticResource BodyTextBlockStyle}" TextAlignment="Center" />
            </Border>
        </Canvas>
    </Grid>
</UserControl>
