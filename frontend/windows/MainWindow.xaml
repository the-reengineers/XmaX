<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="XmaX.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="XmaX">

    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Page content -->
        <Frame x:Name="RootFrame" Grid.Row="0" />

        <!-- Bottom tab navigation -->
        <Grid Grid.Row="1" Background="{ThemeResource AcrylicBackgroundFillColorDefaultBrush}">
            <NavigationView x:Name="NavView"
                            PaneDisplayMode="Top"
                            IsBackButtonVisible="Collapsed"
                            IsSettingsVisible="False"
                            SelectionChanged="OnNavSelectionChanged">
                <NavigationView.MenuItems>
                    <NavigationViewItem Tag="home" />
                    <NavigationViewItem Tag="profiles" />
                    <NavigationViewItem Tag="cooling" />
                    <NavigationViewItem Tag="settings" />
                </NavigationView.MenuItems>
            </NavigationView>
        </Grid>
    </Grid>
</Window>
