<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE policyconfig PUBLIC
 "-//freedesktop//DTD PolicyKit Policy Configuration 1.0//EN"
 "http://www.freedesktop.org/standards/PolicyKit/1.0/policyconfig.dtd">
<!--
  polkit actions gate the privileged D-Bus methods on org.xmax.Service.
  Install to: /usr/share/polkit-1/actions/org.xmax.policy
-->
<policyconfig>
  <vendor>XmaX</vendor>
  <vendor_url>https://example.invalid/xmax</vendor_url>
  <icon_name>xmax</icon_name>

  <action id="org.xmax.set-tdp">
    <description>Set CPU TDP limits</description>
    <message>Authentication is required to change the CPU TDP limits</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/local/bin/xmaxd</annotate>
  </action>

  <action id="org.xmax.set-fan">
    <description>Set fan mode</description>
    <message>Authentication is required to change the fan mode</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/local/bin/xmaxd</annotate>
  </action>

  <action id="org.xmax.set-charge-limit">
    <description>Set battery charge limit</description>
    <message>Authentication is required to change the battery charge limit</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/local/bin/xmaxd</annotate>
  </action>

  <action id="org.xmax.set-auto-start">
    <description>Enable or disable start at boot</description>
    <message>Authentication is required to change the start-at-boot setting</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/local/bin/xmaxd</annotate>
  </action>

  <!-- Gates the session_persist flag: enabling it applies all configured
       settings (TDP, fan, charge limit, active profile) to hardware, so it
       needs the same authorization as the writes it unlocks. -->
  <action id="org.xmax.set-session-persist">
    <description>Apply XmaX settings to hardware</description>
    <message>Authentication is required to let XmaX apply settings to the hardware</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/local/bin/xmaxd</annotate>
  </action>

  <action id="org.xmax.set-profile">
    <description>Apply, save, or delete a power profile</description>
    <message>Authentication is required to change power profiles</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/local/bin/xmaxd</annotate>
  </action>

  <action id="org.xmax.set-fan-curve">
    <description>Save or delete a fan curve</description>
    <message>Authentication is required to change fan curves</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/local/bin/xmaxd</annotate>
  </action>

  <!-- Gates SetCooling and SetCoolingRgb (Frost Bay external cooler). -->
  <action id="org.xmax.set-cooling">
    <description>Change Frost Bay cooler settings</description>
    <message>Authentication is required to change the Frost Bay cooler settings</message>
    <defaults>
      <allow_any>no</allow_any>
      <allow_inactive>no</allow_inactive>
      <allow_active>auth_admin</allow_active>
    </defaults>
    <annotate key="org.freedesktop.policykit.exec.path">/usr/local/bin/xmaxd</annotate>
  </action>
</policyconfig>