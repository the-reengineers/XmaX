<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="XmaX.Widgets.AdaptiveWidget"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <Grid Padding="4" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="TitleText" Style="{StaticResource BodyStrongTextBlockStyle}" />

        <!-- Adaptive profile cards (tuning presets) in a grid -->
        <Grid x:Name="PresetGrid" Grid.Row="1" ColumnSpacing="8" RowSpacing="8" />
    </Grid>
</UserControl>
