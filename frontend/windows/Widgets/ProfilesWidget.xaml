<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="XmaX.Widgets.ProfilesWidget"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <Grid x:Name="RootGrid" Padding="0 4" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="TitleText"
                   Style="{StaticResource BodyStrongTextBlockStyle}"
                   TextTrimming="CharacterEllipsis"
                   TextWrapping="NoWrap"
                   MaxLines="1" />

        <!-- Scrollable grid of profile cards (columns created dynamically) -->
        <ScrollViewer x:Name="CardsScroller" Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled"
                      ManipulationMode="System"
                      ViewChanged="OnCardsScrollerViewChanged"
                      ManipulationStarted="OnCardsScrollerManipulationStarted"
                      ManipulationCompleted="OnCardsScrollerManipulationCompleted"
                      ManipulationInertiaStarting="OnCardsScrollerInertiaStarting">
            <Grid x:Name="CardsGrid" ColumnSpacing="8" RowSpacing="8" />
        </ScrollViewer>
    </Grid>
</UserControl>
