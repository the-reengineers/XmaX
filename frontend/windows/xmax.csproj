<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>XmaX</RootNamespace>
    <AssemblyName>XmaX</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Platforms>x86;x64;ARM64</Platforms>
    <RuntimeIdentifiers>win-x86;win-x64;win-arm64</RuntimeIdentifiers>
    <PublishProfile>win-$(Platform).pubxml</PublishProfile>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <EnableMsixTooling>true</EnableMsixTooling>
    <SelfContained>true</SelfContained>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- Version info -->
    <AssemblyTitle>XmaX</AssemblyTitle>
    <Description>XmaX</Description>
    <Product>XmaX</Product>
    <Company>XmaX</Company>
    <Version>0.1.0</Version>
    <!-- Application icon -->
    <ApplicationIcon>Assets\logo.ico</ApplicationIcon>
  </PropertyGroup>

  <!-- Exclude test project from compilation -->
  <ItemGroup>
    <Compile Remove="xmax.Tests\**" />
    <None Remove="xmax.Tests\**" />
    <Page Remove="xmax.Tests\**" />
    <ApplicationDefinition Remove="xmax.Tests\**" />
    <XamlAppDef Remove="xmax.Tests\**" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="Assets\**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.7.250909003" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.6584" />
  </ItemGroup>

  <!-- Test project reference removed - tests are a separate project in the solution -->

  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <!--
    Defining the "Msix" ProjectCapability here allows the Single-Project MSIX Packaging
    Tools extension to be used for packaging the application.
  -->
  <PropertyGroup>
    <MsixPackageProjectCapability Condition="'$(EnableMsixTooling)' == 'true'">true</MsixPackageProjectCapability>
  </PropertyGroup>
</Project>
