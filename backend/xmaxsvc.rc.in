#include <windows.h>

// Icon resource
IDI_ICON1 ICON "@CMAKE_CURRENT_SOURCE_DIR@/logo.ico"

// Version information
VS_VERSION_INFO VERSIONINFO
FILEVERSION     0,1,0,0
PRODUCTVERSION  0,1,0,0
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
FILEFLAGS       0
FILEOS          VOS_NT_WINDOWS32
FILETYPE        VFT_APP
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904B0"
        BEGIN
            VALUE "CompanyName",      "XmaX"
            VALUE "FileDescription",  "XmaX Service"
            VALUE "FileVersion",      "0.1.0.0"
            VALUE "InternalName",     "xmaxsvc"
            VALUE "LegalCopyright",   "Copyright (C) 2026"
            VALUE "OriginalFilename", "xmaxsvc.exe"
            VALUE "ProductName",      "XmaX"
            VALUE "ProductVersion",   "0.1.0.0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
