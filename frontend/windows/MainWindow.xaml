<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="XmaX.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="XmaX">

    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Page content -->
        <Frame x:Name="RootFrame" Grid.Row="0" />

        <!-- Bottom bar: marquee + edit icon + settings icon -->
        <Grid Grid.Row="1"
              Background="{ThemeResource SmokeFillColorDefaultBrush}"
              Padding="12,6"
              Height="48">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Marquee banner (fills available space) -->
            <Grid x:Name="MarqueeContainer" Grid.Column="0" VerticalAlignment="Center">
                <TextBlock x:Name="MarqueeText"
                           VerticalAlignment="Center"
                           TextWrapping="NoWrap"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </Grid>

            <!-- Edit icon (visual only for now) -->
            <Button x:Name="EditButton"
                    Grid.Column="1"
                    Background="Transparent"
                    BorderThickness="0"
                    Padding="8"
                    CornerRadius="4"
                    VerticalAlignment="Center"
                    Click="OnEditClick">
                <FontIcon Glyph="&#xEB04;"
                          FontFamily="/Assets/tabler-icons.ttf#tabler-icons"
                          FontSize="20"
                          Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </Button>

            <!-- Settings icon -->
            <Button x:Name="SettingsButton"
                    Grid.Column="2"
                    Background="Transparent"
                    BorderThickness="0"
                    Padding="8"
                    CornerRadius="4"
                    VerticalAlignment="Center"
                    Click="OnSettingsClick">
                <FontIcon Glyph="&#xEB20;"
                          FontFamily="/Assets/tabler-icons.ttf#tabler-icons"
                          FontSize="18"
                          Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </Button>
        </Grid>
    </Grid>
</Window>
