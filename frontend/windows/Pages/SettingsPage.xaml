<Page
    x:Class="XmaX.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Breadcrumb header -->
        <BreadcrumbBar x:Name="BreadcrumbBar" Grid.Row="0"
                       Margin="12,16,24,8"
                       ItemClicked="OnBreadcrumbItemClicked">
            <BreadcrumbBar.ItemTemplate>
                <DataTemplate>
                    <Grid VerticalAlignment="Center" Margin="8,0">
                        <!-- Icon for Home -->
                        <FontIcon x:Name="IconElement" Glyph="{Binding IconGlyph}"
                                  FontFamily="/Assets/tabler-icons.ttf#tabler-icons"
                                  FontSize="20"
                                  Visibility="{Binding IconVisibility}" />
                        <!-- Text for other items -->
                        <TextBlock x:Name="TextElement" Text="{Binding Text}"
                                   Style="{StaticResource SubtitleTextBlockStyle}"
                                   VerticalAlignment="Center"
                                   Visibility="{Binding TextVisibility}" />
                    </Grid>
                </DataTemplate>
            </BreadcrumbBar.ItemTemplate>
        </BreadcrumbBar>

        <!-- Content frame for sub-pages -->
        <Frame x:Name="SubPageFrame" Grid.Row="1" />
    </Grid>
</Page>
