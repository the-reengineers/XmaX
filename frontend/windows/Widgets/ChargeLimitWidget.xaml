<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="XmaX.Widgets.ChargeLimitWidget"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">

    <Grid Padding="12" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="TitleText" Style="{StaticResource BodyStrongTextBlockStyle}" />

        <Button x:Name="ChargeLimitButton" Grid.Row="1"
                HorizontalAlignment="Stretch"
                Click="OnCycleClick">
            <StackPanel Orientation="Horizontal" Spacing="8">
                <FontIcon Glyph="&#xE977;" FontSize="16" />
                <TextBlock x:Name="ChargeLimitText" VerticalAlignment="Center" />
            </StackPanel>
        </Button>
    </Grid>
</UserControl>
