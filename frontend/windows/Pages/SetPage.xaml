<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="XmaX.Pages.SetPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d">

    <Grid>
        <Grid.ColumnDefinitions>
            <!-- Left panel: available widgets (width set in code-behind) -->
            <ColumnDefinition x:Name="LeftPanelColumn" Width="460" />
            <!-- Right panel: home preview -->
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Left Panel: Available Widgets -->
        <ScrollViewer Grid.Column="0"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <Grid x:Name="AvailableWidgetsGrid"
                  Padding="12"
                  RowSpacing="8"
                  ColumnSpacing="8">
                <!-- Populated in code-behind -->
            </Grid>
        </ScrollViewer>

        <!-- Right Panel: Home Preview -->
        <ScrollViewer Grid.Column="1"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <Grid x:Name="HomePreviewGrid"
                  Padding="12"
                  RowSpacing="8"
                  ColumnSpacing="8">
                <!-- Populated in code-behind -->
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>
