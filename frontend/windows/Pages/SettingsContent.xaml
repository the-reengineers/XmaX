<Page
    x:Class="XmaX.Pages.SettingsContent"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer Padding="24,16" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="16" MaxWidth="600">

            <!-- Language -->
            <StackPanel Spacing="4">
                <TextBlock x:Name="LanguageLabel" Style="{StaticResource BodyStrongTextBlockStyle}" />
                <ComboBox x:Name="LanguageCombo" HorizontalAlignment="Stretch"
                          SelectionChanged="OnLanguageChanged" />
            </StackPanel>

            <!-- Theme -->
            <StackPanel Spacing="4">
                <TextBlock x:Name="ThemeLabel" Style="{StaticResource BodyStrongTextBlockStyle}" />
                <ComboBox x:Name="ThemeCombo" HorizontalAlignment="Stretch"
                          SelectionChanged="OnThemeChanged" />
            </StackPanel>

            <!-- Persist -->
            <StackPanel Spacing="4">
                <TextBlock x:Name="PersistLabel" Style="{StaticResource BodyStrongTextBlockStyle}" />
                <TextBlock x:Name="PersistDescLabel"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{StaticResource TextFillColorSecondaryBrush}" />
                <ToggleSwitch x:Name="PersistToggle" Toggled="OnPersistToggled" />
            </StackPanel>

            <!-- Auto-start -->
            <StackPanel Spacing="4">
                <TextBlock x:Name="AutoStartLabel" Style="{StaticResource BodyStrongTextBlockStyle}" />
                <TextBlock x:Name="AutoStartDescLabel"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{StaticResource TextFillColorSecondaryBrush}" />
                <ToggleSwitch x:Name="AutoStartToggle" Toggled="OnAutoStartToggled" />
            </StackPanel>

            <!-- Column count -->
            <StackPanel Spacing="4">
                <TextBlock x:Name="ColumnsLabel" Style="{StaticResource BodyStrongTextBlockStyle}" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Slider x:Name="ColumnsSlider" StepFrequency="1"
                            Width="200" ValueChanged="OnColumnsChanged"
                            TickFrequency="1" TickPlacement="Inline" />
                    <TextBlock x:Name="ColumnsValue" VerticalAlignment="Center"
                               Style="{StaticResource BodyTextBlockStyle}" />
                </StackPanel>
            </StackPanel>

            <!-- Sub-page navigation -->
            <StackPanel Spacing="4" Margin="0,8,0,0">
                <Button Click="OnNavigateProfiles" HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch" Padding="0"
                        BorderThickness="0" Background="Transparent">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Grid x:Name="RootGrid" CornerRadius="4"
                                  Padding="12,12" Margin="0,1"
                                  Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver">
                                            <Storyboard>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="RootGrid" Storyboard.TargetProperty="Background">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource CardBackgroundFillColorSecondaryBrush}" />
                                                </ObjectAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <Storyboard>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="RootGrid" Storyboard.TargetProperty="Background">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource CardBackgroundFillColorSecondaryBrush}" />
                                                </ObjectAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Glyph="&#xEC38;" FontFamily="/Assets/tabler-icons.ttf#tabler-icons" FontSize="16" Margin="0,0,12,0"
                                          VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock x:Name="ProfilesNavLabel"
                                               Style="{StaticResource BodyStrongTextBlockStyle}" />
                                    <TextBlock x:Name="ProfilesNavDesc"
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <FontIcon Grid.Column="2" Glyph="&#xE76C;" FontSize="12"
                                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                          VerticalAlignment="Center" />
                            </Grid>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <Button Click="OnNavigateCooling" HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch" Padding="0"
                        BorderThickness="0" Background="Transparent">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Grid x:Name="RootGrid" CornerRadius="4"
                                  Padding="12,12" Margin="0,1"
                                  Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver">
                                            <Storyboard>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="RootGrid" Storyboard.TargetProperty="Background">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource CardBackgroundFillColorSecondaryBrush}" />
                                                </ObjectAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <Storyboard>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="RootGrid" Storyboard.TargetProperty="Background">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource CardBackgroundFillColorSecondaryBrush}" />
                                                </ObjectAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Glyph="&#xFDB3;" FontFamily="/Assets/tabler-icons.ttf#tabler-icons" FontSize="16" Margin="0,0,12,0"
                                          VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock x:Name="CoolingNavLabel"
                                               Style="{StaticResource BodyStrongTextBlockStyle}" />
                                    <TextBlock x:Name="CoolingNavDesc"
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <FontIcon Grid.Column="2" Glyph="&#xE76C;" FontSize="12"
                                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                          VerticalAlignment="Center" />
                            </Grid>
                        </ControlTemplate>
                    </Button.Template>
                </Button>

                <Button Click="OnNavigatePowerStates" HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch" Padding="0"
                        BorderThickness="0" Background="Transparent">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Grid x:Name="RootGrid" CornerRadius="4"
                                  Padding="12,12" Margin="0,1"
                                  Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                                <VisualStateManager.VisualStateGroups>
                                    <VisualStateGroup x:Name="CommonStates">
                                        <VisualState x:Name="Normal" />
                                        <VisualState x:Name="PointerOver">
                                            <Storyboard>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="RootGrid" Storyboard.TargetProperty="Background">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource CardBackgroundFillColorSecondaryBrush}" />
                                                </ObjectAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </VisualState>
                                        <VisualState x:Name="Pressed">
                                            <Storyboard>
                                                <ObjectAnimationUsingKeyFrames Storyboard.TargetName="RootGrid" Storyboard.TargetProperty="Background">
                                                    <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource CardBackgroundFillColorSecondaryBrush}" />
                                                </ObjectAnimationUsingKeyFrames>
                                            </Storyboard>
                                        </VisualState>
                                    </VisualStateGroup>
                                </VisualStateManager.VisualStateGroups>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <FontIcon Glyph="&#xEA38;" FontFamily="/Assets/tabler-icons.ttf#tabler-icons" FontSize="16" Margin="0,0,12,0"
                                          VerticalAlignment="Center" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                    <TextBlock x:Name="PowerStatesNavLabel"
                                               Style="{StaticResource BodyStrongTextBlockStyle}" />
                                    <TextBlock x:Name="PowerStatesNavDesc"
                                               Style="{StaticResource CaptionTextBlockStyle}"
                                               Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                                </StackPanel>
                                <FontIcon Grid.Column="2" Glyph="&#xE76C;" FontSize="12"
                                          Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                          VerticalAlignment="Center" />
                            </Grid>
                        </ControlTemplate>
                    </Button.Template>
                </Button>
            </StackPanel>

            <!-- Revert to defaults -->
            <StackPanel Spacing="8" Margin="0,8,0,0">
                <Button x:Name="RevertButton"
                        Click="OnRevertClick" HorizontalAlignment="Stretch" />
            </StackPanel>

            <!-- Factory reset (danger zone) -->
            <StackPanel Spacing="8" Margin="0,16,0,0">
                <Border BorderBrush="{ThemeResource SystemFillColorCriticalBrush}"
                        BorderThickness="1" CornerRadius="8" Padding="16">
                    <StackPanel Spacing="8">
                        <TextBlock x:Name="FactoryResetLabel"
                                   Style="{StaticResource BodyStrongTextBlockStyle}"
                                   Foreground="{ThemeResource SystemFillColorCriticalBrush}" />
                        <TextBlock x:Name="FactoryResetDescLabel"
                                   Style="{StaticResource CaptionTextBlockStyle}"
                                   Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                   TextWrapping="Wrap" />
                        <Button x:Name="FactoryResetButton"
                                Click="OnFactoryResetClick"
                                HorizontalAlignment="Stretch"
                                Background="{ThemeResource SystemFillColorCriticalBrush}"
                                Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- Developer tools -->
            <Button Click="OnNavigatePlayground" HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Stretch" Padding="0"
                    BorderThickness="0" Background="Transparent" Margin="0,8,0,0">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Grid x:Name="RootGrid" CornerRadius="4"
                              Padding="12,12" Margin="0,1"
                              Background="{ThemeResource CardBackgroundFillColorDefaultBrush}">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="RootGrid" Storyboard.TargetProperty="Background">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource CardBackgroundFillColorSecondaryBrush}" />
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="Pressed">
                                        <Storyboard>
                                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="RootGrid" Storyboard.TargetProperty="Background">
                                                <DiscreteObjectKeyFrame KeyTime="0" Value="{ThemeResource CardBackgroundFillColorSecondaryBrush}" />
                                            </ObjectAnimationUsingKeyFrames>
                                        </Storyboard>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <FontIcon Glyph="&#xE943;" FontSize="16" Margin="0,0,12,0"
                                      VerticalAlignment="Center" />
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock x:Name="PlaygroundNavLabel"
                                           Style="{StaticResource BodyStrongTextBlockStyle}" />
                                <TextBlock x:Name="PlaygroundNavDesc"
                                           Style="{StaticResource CaptionTextBlockStyle}"
                                           Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
                            </StackPanel>
                            <FontIcon Grid.Column="2" Glyph="&#xE76C;" FontSize="12"
                                      Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                      VerticalAlignment="Center" />
                        </Grid>
                    </ControlTemplate>
                </Button.Template>
            </Button>

        </StackPanel>
    </ScrollViewer>
</Page>
