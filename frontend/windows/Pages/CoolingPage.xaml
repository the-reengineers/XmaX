<?xml version="1.0" encoding="utf-8"?>
<Page x:Class="XmaX.Pages.CoolingPage"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
      mc:Ignorable="d">

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="16" Padding="16">
            <!-- Fan Curves Section -->
            <TextBlock x:Name="FanCurvesTitle" Style="{StaticResource SubtitleTextBlockStyle}" />
            <Button x:Name="CreateFanCurveBtn" Click="OnCreateFanCurveClick" Style="{StaticResource AccentButtonStyle}" />
            <ItemsControl x:Name="FanCurvesList" Margin="0,8,0,0" />
        </StackPanel>
    </ScrollViewer>
</Page>
