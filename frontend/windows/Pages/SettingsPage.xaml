<Page
    x:Class="XmaX.Pages.SettingsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <ScrollViewer Padding="24,16" VerticalScrollBarVisibility="Auto">
        <StackPanel Spacing="16" MaxWidth="600">

            <!-- Language -->
            <StackPanel Spacing="4">
                <TextBlock x:Name="LanguageLabel" Style="{StaticResource BodyStrongTextBlockStyle}" />
                <ComboBox x:Name="LanguageCombo" HorizontalAlignment="Stretch"
                          SelectionChanged="OnLanguageChanged" />
            </StackPanel>

            <!-- Theme -->
            <StackPanel Spacing="4">
                <TextBlock x:Name="ThemeLabel" Style="{StaticResource BodyStrongTextBlockStyle}" />
                <ComboBox x:Name="ThemeCombo" HorizontalAlignment="Stretch"
                          SelectionChanged="OnThemeChanged" />
            </StackPanel>

            <!-- Persist -->
            <StackPanel Spacing="4">
                <TextBlock x:Name="PersistLabel" Style="{StaticResource BodyStrongTextBlockStyle}" />
                <TextBlock x:Name="PersistDescLabel"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{StaticResource TextFillColorSecondaryBrush}" />
                <ToggleSwitch x:Name="PersistToggle" Toggled="OnPersistToggled" />
            </StackPanel>

            <!-- Auto-start -->
            <StackPanel Spacing="4">
                <TextBlock x:Name="AutoStartLabel" Style="{StaticResource BodyStrongTextBlockStyle}" />
                <TextBlock x:Name="AutoStartDescLabel"
                           Style="{StaticResource CaptionTextBlockStyle}"
                           Foreground="{StaticResource TextFillColorSecondaryBrush}" />
                <ToggleSwitch x:Name="AutoStartToggle" Toggled="OnAutoStartToggled" />
            </StackPanel>

            <!-- Column count -->
            <StackPanel Spacing="4">
                <TextBlock x:Name="ColumnsLabel" Style="{StaticResource BodyStrongTextBlockStyle}" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Slider x:Name="ColumnsSlider" StepFrequency="1"
                            Width="200" ValueChanged="OnColumnsChanged"
                            TickFrequency="1" TickPlacement="Inline" />
                    <TextBlock x:Name="ColumnsValue" VerticalAlignment="Center"
                               Style="{StaticResource BodyTextBlockStyle}" />
                </StackPanel>
            </StackPanel>

            <!-- Widget layout -->
            <StackPanel Spacing="8">
                <TextBlock x:Name="WidgetLayoutLabel" Style="{StaticResource BodyStrongTextBlockStyle}" />
                <ItemsControl x:Name="WidgetLayoutList">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Grid Padding="8" ColumnSpacing="8" Margin="0,2"
                                  Background="{StaticResource CardBackgroundFillColorDefaultBrush}"
                                  CornerRadius="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <TextBlock Grid.Column="0" VerticalAlignment="Center"
                                           Text="{Binding Label}" />

                                <ToggleSwitch Grid.Column="1" IsOn="{Binding IsVisible, Mode=TwoWay}"
                                              VerticalAlignment="Center"
                                              Toggled="OnWidgetVisibilityToggled"
                                              Tag="{Binding WidgetId}" />

                                <Button Grid.Column="2" Content="↑" Tag="{Binding WidgetId}"
                                        Click="OnMoveWidgetUp" VerticalAlignment="Center" />

                                <Button Grid.Column="3" Content="↓" Tag="{Binding WidgetId}"
                                        Click="OnMoveWidgetDown" VerticalAlignment="Center" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>

            <!-- Revert to defaults -->
            <StackPanel Spacing="8" Margin="0,8,0,0">
                <Button x:Name="RevertButton"
                        Click="OnRevertClick" HorizontalAlignment="Stretch" />
            </StackPanel>

        </StackPanel>
    </ScrollViewer>
</Page>
