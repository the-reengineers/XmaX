<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="XmaX.HomeEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:wf="using:XmaX.WidgetFramework"
        mc:Ignorable="d"
        Title="Home Editor">

    <Grid Background="Transparent">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Title bar with close button -->
        <Grid Padding="24,16,16,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Title -->
            <TextBlock Text="Edit Widgets"
                       Style="{StaticResource SubtitleTextBlockStyle}"
                       VerticalAlignment="Center" />

            <!-- Close button -->
            <Button Grid.Column="1"
                    Background="Transparent"
                    BorderThickness="0"
                    Padding="8"
                    CornerRadius="4"
                    VerticalAlignment="Center"
                    Click="OnCloseClick">
                <FontIcon Glyph="&#xE711;"
                          FontSize="16"
                          Foreground="{ThemeResource TextFillColorSecondaryBrush}" />
            </Button>
        </Grid>

        <!-- Content area: hidden widgets using WidgetGridHost -->
        <wf:WidgetGridHost x:Name="HiddenWidgetsHost" Grid.Row="1" />

        <!-- Bottom spacer matching MainWindow's bottom bar height,
             so both windows have the same widget-area proportions
             and the same number of visible rows at the same total height. -->
        <Border Grid.Row="2" Height="50" />
    </Grid>
</Window>
